# Copie para .env e preencha. Rode com: node --env-file=.env src/server.js
# Basta UMA chave de IA. Com várias, a Siart troca de provedor sozinha quando um falha.
SAMBANOVA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PORT=3000
# Senha de acesso ao site (recomendado em qualquer URL pública)
# ACCESS_CODE=
# Onde ficam os arquivos dos projetos (padrão: ./data)
# DATA_DIR=./data

# Nível padrão e limites
# DEFAULT_TIER=moyenne
# MAX_CONVERSATIONS=30
# MAX_MESSAGES_PER_CONVERSATION=40

# Cadeias de modelos por nível: provedor:modelo,provedor:modelo (tenta na ordem)
# TIER_ABSOLUTY=gemini:gemini-2.5-pro,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,sambanova:gpt-oss-120b
# TIER_MOYENNE=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash,openrouter:openai/gpt-oss-120b:free,sambanova:gpt-oss-120b
# TIER_BASSE=groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite,openrouter:openai/gpt-oss-20b:free,sambanova:gpt-oss-120b
# TIER_BASSE_TOOLS=1            # liga as ferramentas de projeto também na Basse (padrão: desligado)
# MAX_TOOL_STEPS=4              # limite rígido de rodadas de ferramentas
# TIER_MOYENNE_FIRST_BYTE_MS=40000   # tempo até o primeiro byte antes de trocar de provedor

# Opcional
# TRUST_PROXY=1
# ALLOWED_ORIGIN=https://seu-dominio.com
# TOOLS_ENABLED=1
# RETENTION_DAYS=30
# RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000
# UPSTREAM_TIMEOUT_MS=180000
