# Copie para .env e preencha. Rode com: node --env-file=.env src/server.js
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
# Senha de acesso ao site (recomendado em qualquer URL pública)
# ACCESS_CODE=
# Onde ficam os arquivos dos projetos (padrão: ./data)
# DATA_DIR=./data
# Opcional
# TRUST_PROXY=1
# ALLOWED_ORIGIN=https://seu-dominio.com
# TOOLS_ENABLED=1
# MAX_TOOL_STEPS=6
# RETENTION_DAYS=30
# RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000
# UPSTREAM_TIMEOUT_MS=120000
# MAX_COMPLETION_TOKENS=4096
